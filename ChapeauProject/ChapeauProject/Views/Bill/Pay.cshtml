@model ChapeauProject.ViewModels.BillViewModel
@using ChapeauProject.ViewModels
@using ChapeauProject.Models

@{
    ViewData["Title"] = "Bill – Table " + Model.TableNumber;
    var methods = Enum.GetValues<PaymentMethod>();
}

<h2 class="page-title">Bill – Table @Model.TableNumber</h2>
<hr />

<div class="bill-wrapper">

    @foreach (var guest in Model.Guests)
    {
        <div class="order-card" style="margin-bottom:1rem;">
            <div class="order-card-header">
                <div class="order-table-num">@guest.GuestName</div>
            </div>
            <table class="bill-table">
                @foreach (var item in guest.Items)
                {
                    <tr>
                        <td>@item.ItemName</td>
                        <td class="td-qty">x@(item.Quantity)</td>
                        <td class="td-price">€@((item.Price * item.Quantity).ToString("F2"))</td>
                    </tr>
                }
            </table>
        </div>
    }

    <div class="order-card" style="margin-bottom:1.5rem;">
        <div class="order-card-header">
            <div class="order-table-num">Order Summary</div>
        </div>
        <table class="bill-summary-table">
            <tr>
                <td>Subtotal (excl. VAT)</td>
                <td class="td-right">€@Model.SubTotalAmount.ToString("F2")</td>
            </tr>
            <tr>
                <td class="td-muted">VAT 9%</td>
                <td class="td-muted-right">€@Model.LowVAT.ToString("F2")</td>
            </tr>
            <tr>
                <td class="td-muted">VAT 21%</td>
                <td class="td-muted-right">€@Model.HighVAT.ToString("F2")</td>
            </tr>
            <tr class="tr-total">
                <td class="td-total">Total (incl. VAT)</td>
                <td class="td-total-right">€@Model.TotalAmount.ToString("F2")</td>
            </tr>
        </table>
    </div>

    @if (Model.SplitMode == SplitMode.Single)
    {
        <div class="split-mode-section">
            <p class="split-mode-title">How would you like to pay?</p>
            <div class="split-mode-buttons">
                <form asp-action="SetSplitMode" asp-controller="Bill" method="post" class="split-mode-form">
                    <input type="hidden" name="tableNumber" value="@Model.TableNumber" />
                    <input type="hidden" name="splitMode" value="@SplitMode.Single" />
                    <button type="submit" class="complete-btn btn-pay-full">Pay in Full</button>
                </form>
                <form asp-action="SetSplitMode" asp-controller="Bill" method="post" class="split-equal-form">
                    <input type="hidden" name="tableNumber" value="@Model.TableNumber" />
                    <input type="hidden" name="splitMode" value="@SplitMode.Equal" />
                    <input type="number" name="splitCount" min="2" max="20" value="2" class="split-count-input" />
                    <button type="submit" class="complete-btn btn-split">Split Equally</button>
                </form>
                <form asp-action="SetSplitMode" asp-controller="Bill" method="post" class="split-mode-form">
                    <input type="hidden" name="tableNumber" value="@Model.TableNumber" />
                    <input type="hidden" name="splitMode" value="@SplitMode.Custom" />
                    <button type="submit" class="complete-btn btn-split">Custom Split</button>
                </form>
                <form asp-action="SetSplitMode" asp-controller="Bill" method="post" class="split-mode-form">
                    <input type="hidden" name="tableNumber" value="@Model.TableNumber" />
                    <input type="hidden" name="splitMode" value="@SplitMode.ByGuest" />
                    <button type="submit" class="complete-btn btn-split">Split by Guest</button>
                </form>
            </div>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-banner">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (Model.SplitMode == SplitMode.Single)
    {
        <form asp-action="Pay" asp-controller="Bill" method="post">
            <input type="hidden" asp-for="TableNumber" />
            <input type="hidden" asp-for="SubTotalAmount" />
            <input type="hidden" asp-for="LowVAT" />
            <input type="hidden" asp-for="HighVAT" />
            <input type="hidden" asp-for="TotalAmount" />
            <input type="hidden" asp-for="SplitMode" />

            <div class="form-field">
                <label class="form-field-label">Tip (€)</label>
                <input asp-for="TipAmount" type="number" min="0" step="0.50" class="form-input" />
            </div>
            <div class="form-field">
                <label class="form-field-label">Payment Method</label>
                <div class="radio-group">
                    @foreach (var method in methods)
                    {
                        <label class="radio-label">
                            <input type="radio" name="PaymentMethod" value="@method" @(Model.PaymentMethod == method ? "checked" : "") />
                            @method
                        </label>
                    }
                </div>
            </div>
            <div class="form-field">
                <label class="form-field-label">Feedback <span class="label-optional">(optional)</span></label>
                <textarea asp-for="Feedback" rows="2" class="form-textarea"></textarea>
            </div>
            <div class="form-actions">
                <button type="submit" class="complete-btn btn-confirm-payment">Confirm Payment</button>
                <a asp-action="Index" asp-controller="Bill" class="link-cancel">Cancel</a>
            </div>
        </form>
    }

    @if (Model.SplitMode != SplitMode.Single && Model.Payers.Any())
    {
        <form asp-action="Pay" asp-controller="Bill" method="post">
            <input type="hidden" asp-for="TableNumber" />
            <input type="hidden" asp-for="SubTotalAmount" />
            <input type="hidden" asp-for="LowVAT" />
            <input type="hidden" asp-for="HighVAT" />
            <input type="hidden" asp-for="TotalAmount" />
            <input type="hidden" asp-for="SplitMode" />

            @{
                decimal remaining = Model.TotalAmount;
            }

            @for (int i = 0; i < Model.Payers.Count; i++)
            {
                var payer = Model.Payers[i];
                <input type="hidden" name="Payers[@i].Name" value="@payer.Name" />
                <input type="hidden" name="Payers[@i].GuestID" value="@payer.GuestID" />

                <div class="order-card" style="margin-bottom:1rem;">
                    <div class="order-card-header">
                        <div class="order-table-num">@payer.Name</div>
                        @if (Model.SplitMode == SplitMode.Custom)
                        {
                            <div class="order-meta">Remaining: €@remaining.ToString("F2")</div>
                        }
                        else
                        {
                            <div class="order-meta">Amount due: €@payer.AmountDue.ToString("F2")</div>
                        }
                    </div>

                    @if (Model.SplitMode == SplitMode.Custom)
                    {
                        <div class="payer-field">
                            <label class="form-field-label-sm">Amount paying (€)</label>
                            <input type="number" name="Payers[@i].AmountDue" min="0" step="0.01" value="@payer.AmountDue" class="form-input-sm" />
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="Payers[@i].AmountDue" value="@payer.AmountDue" />
                    }

                    <div class="payer-field">
                        <label class="form-field-label-sm">Tip (€)</label>
                        <input type="number" name="Payers[@i].TipAmount" min="0" step="0.50" value="0" class="form-input-sm" />
                    </div>

                    <div class="payer-field">
                        <label class="form-field-label-sm">Payment Method</label>
                        <div class="radio-group" style="margin-top:4px;">
                            @foreach (var method in methods)
                            {
                                <label class="radio-label-sm">
                                    <input type="radio" name="Payers[@i].PaymentMethod" value="@method" @(method == PaymentMethod.Cash ? "checked" : "") />
                                    @method
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="form-field-label-sm">Feedback <span class="label-optional">(optional)</span></label>
                        <textarea name="Payers[@i].Feedback" rows="2" class="form-textarea-sm"></textarea>
                    </div>
                </div>

                remaining -= payer.AmountDue;
            }

            @if (Model.SplitMode == SplitMode.Custom)
            {
                <div id="payers-container"></div>
                <button type="button" onclick="addPayer()" class="complete-btn btn-add-person">+ Add Person</button>
                <p class="hint-text">Total must be at least €@Model.TotalAmount.ToString("F2").</p>
            }

            <div class="form-actions">
                <button type="submit" class="complete-btn btn-confirm-payment">Confirm Payment</button>
                <a asp-action="Pay" asp-controller="Bill" asp-route-TableNumber="@Model.TableNumber" class="link-cancel">Start Over</a>
            </div>
        </form>
    }
</div>

@if (Model.SplitMode == SplitMode.Custom)
{
    <script>
        let payerCount = @Model.Payers.Count;
        const methods = [@string.Join(", ", Enum.GetValues<PaymentMethod>().Select(m => $"'{m}'"))];

        function addPayer() {
            const i = payerCount++;
            const container = document.getElementById('payers-container');
            const card = document.createElement('div');
            card.className = 'order-card';
            card.style.marginBottom = '1rem';
            card.innerHTML = `
                <div class="order-card-header">
                    <div class="order-table-num">Person ${i + 1}</div>
                </div>
                <div class="payer-field">
                    <label class="form-field-label-sm">Amount paying (€)</label>
                    <input type="number" name="Payers[${i}].AmountDue" min="0" step="0.01" value="0" class="form-input-sm" />
                </div>
                <div class="payer-field">
                    <label class="form-field-label-sm">Tip (€)</label>
                    <input type="number" name="Payers[${i}].TipAmount" min="0" step="0.50" value="0" class="form-input-sm" />
                </div>
                <div class="payer-field">
                    <label class="form-field-label-sm">Payment Method</label>
                    <div class="radio-group" style="margin-top:4px;">
                        ${methods.map((m, mi) => `
                            <label class="radio-label-sm">
                                <input type="radio" name="Payers[${i}].PaymentMethod" value="${m}" ${mi === 0 ? 'checked' : ''} />
                                ${m}
                            </label>`).join('')}
                    </div>
                </div>
                <div>
                    <label class="form-field-label-sm">Feedback <span class="label-optional">(optional)</span></label>
                    <textarea name="Payers[${i}].Feedback" rows="2" class="form-textarea-sm"></textarea>
                </div>
                <input type="hidden" name="Payers[${i}].Name" value="Person ${i + 1}" />
            `;
            container.appendChild(card);
        }
    </script>
}
