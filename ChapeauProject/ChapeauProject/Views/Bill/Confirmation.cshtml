@model int

@{
    ViewData["Title"] = "Payment Confirmed";
    int tableNumber = Model;
}

<div class="confirmation-wrapper">
    <div class="confirmation-icon">✅</div>
    <h2 class="page-title" style="margin-bottom:0.5rem;">Payment Confirmed</h2>
    <p class="text-muted" style="margin-bottom:2rem;">
        Table @tableNumber has been marked as free and the order has been closed.
    </p>
    <div class="confirmation-actions">
        <a asp-action="Index" asp-controller="Tables" class="complete-btn btn-inline" style="padding:10px 24px;">
            Back to Tables
        </a>
        <a asp-action="Index" asp-controller="Bill" class="view-orders-btn btn-inline" style="padding:10px 24px;">
            Process Another Bill
        </a>
    </div>
</div>
