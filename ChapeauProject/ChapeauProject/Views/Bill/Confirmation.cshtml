@{
    ViewData["Title"] = "Payment Confirmed";
    int tableNumber = ViewBag.TableNumber;
}

<div style="max-width:480px; margin:3rem auto; text-align:center;">
    <div style="font-size:3.5rem; margin-bottom:1rem;">✅</div>
    <h2 style="font-family:'Playfair Display',serif; color:var(--bistro-text); margin-bottom:0.5rem;">
        Payment Confirmed
    </h2>
    <p style="color:#888; margin-bottom:2rem;">
        Table @tableNumber has been marked as free and the order has been closed.
    </p>

    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a asp-action="Index" asp-controller="Tables" class="complete-btn"
           style="display:inline-block; width:auto; padding:10px 24px; text-decoration:none;">
            Back to Tables
        </a>
        <a asp-action="Index" asp-controller="Bill" class="view-orders-btn"
           style="display:inline-block; width:auto; padding:10px 24px; text-decoration:none;">
            Process Another Bill
        </a>
    </div>
</div>
