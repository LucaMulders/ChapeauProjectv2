@model IEnumerable<ChapeauProject.ViewModels.TablesViewModel>

@{
    ViewData["Title"] = "Bill";
}

<h2 class="page-title">Process a Bill</h2>
<p class="text-muted">Select an occupied table to process its bill.</p>
<hr />

@if (!Model.Any())
{
    <p class="text-muted">No occupied tables at the moment.</p>
}
else
{
    <div class="tables-grid">
        @foreach (var item in Model.OrderBy(t => t.Table.TableNumber))
        {
            @await Html.PartialAsync("_BillTableCard", item)
        }
    </div>
}
