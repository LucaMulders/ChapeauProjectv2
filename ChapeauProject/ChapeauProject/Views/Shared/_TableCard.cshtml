@model ChapeauProject.ViewModels.TablesViewModel

<div class="table-card">
    <form asp-action="ToggleOccupied" asp-controller="Tables" method="post" class="table-card-form">
        <input type="hidden" name="tableNumber" value="@Model.Table.TableNumber" />
        <button type="submit" class="table-toggle-btn">
            <div class="table-shape @(Model.Table.Seats <= 2 ? "round" : Model.Table.Seats <= 4 ? "rect" : "large") @(Model.Table.IsOccupied ? "occupied" : "free")">
                <i class="ti ti-armchair"></i>
            </div>
        </button>
        <div class="table-num">Table @Model.Table.TableNumber</div>
        <div class="table-seats">@Model.GuestCount / @Model.Table.Seats guests</div>
        <span class="status-badge @(Model.Table.IsOccupied ? "badge-occupied" : "badge-free")">
            @(Model.Table.IsOccupied ? "Occupied" : "Free")
        </span>
        <span class="table-seats">@Model.OrderCount orders</span>
        @if (Model.HasFoodOrder || Model.HasDrinkOrder)
        {
            <div class="order-icons">
                @if (Model.HasFoodOrder)
                {
                    <span class="order-icon" title="Running food order">🍽️</span>
                }
                @if (Model.HasDrinkOrder)
                {
                    <span class="order-icon" title="Running drink order">🍷</span>
                }
            </div>
        }

        <!-- Maybe make a viewmodel? -->
        @if (Model.RunningOrderStatus != null)
        {
            string statusLabel = Model.RunningOrderStatus switch
            {
                "Pending"   => "Ordered",
                "Preparing" => "Preparing",
                "Ready"     => "Ready",
                _           => Model.RunningOrderStatus
            };
            string statusCss = Model.RunningOrderStatus switch
            {
                "Pending"   => "order-status-badge order-status-ordered",
                "Preparing" => "order-status-badge order-status-preparing",
                "Ready"     => "order-status-badge order-status-ready",
                _           => "order-status-badge"
            };
            <span class="@statusCss">@statusLabel</span>
        }
    </form>

    <div class="table-card-actions">
        <a asp-action="Details" asp-controller="Tables" asp-route-tableNumber="@Model.Table.TableNumber" class="view-orders-btn">
            Add / View Orders
        </a>
    </div>
</div>
