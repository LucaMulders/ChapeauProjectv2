
@model IEnumerable<ChapeauProject.ViewModels.TablesViewModel>

@{
    ViewData["Title"] = "Tables";
}

<partial name="_ErrorMessage" />
<partial name="_SuccessMessage" />

<div class="header-bar-right">
    <a asp-action="Index" class="complete-btn btn-inline">&#8635; Refresh</a>
</div>

<div class="stat-bar">
    <div class="stat-card"><div class="stat-label">Total</div><div class="stat-value">@Model.Count()</div></div>
    <div class="stat-card"><div class="stat-label">Free</div><div class="stat-value stat-value-free">@Model.Count(t => !t.Table.IsOccupied)</div></div>
    <div class="stat-card"><div class="stat-label">Occupied</div><div class="stat-value stat-value-occupied">@Model.Count(t => t.Table.IsOccupied)</div></div>
</div>

<div class="tables-grid">
    @foreach (var item in Model)
    {
        @await Html.PartialAsync("_TableCard", item)
    }
</div>
