
@model IEnumerable<ChapeauProject.ViewModels.TablesViewModel>

@{
    ViewData["Title"] = "Tables";
}

@if (TempData["Error"] != null)
{
    <div class="alert-banner">@TempData["Error"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="header-bar-right">
    <a asp-action="Index" class="complete-btn btn-inline">&#8635; Refresh</a>
</div>

<div class="stat-bar">
    <div class="stat-card"><div class="stat-label">Total</div><div class="stat-value">@Model.Count()</div></div>
    <div class="stat-card"><div class="stat-label">Free</div><div class="stat-value stat-value-free">@ViewBag.FreeCount</div></div>
    <div class="stat-card"><div class="stat-label">Occupied</div><div class="stat-value stat-value-occupied">@ViewBag.OccupiedCount</div></div>
</div>

<div class="tables-grid">
    @foreach (var item in Model)
    {
        @await Html.PartialAsync("_TableCard", item)
    }
</div>
