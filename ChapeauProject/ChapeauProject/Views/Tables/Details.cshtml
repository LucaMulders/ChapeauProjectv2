@model ChapeauProject.ViewModels.TableOrderViewModel
@using ChapeauProject.Models

@{
    ViewData["Title"] = "Table " + Model.TableNumber + " Orders";
    var menuItems = ViewBag.MenuItems as List<ChapeauProject.Models.MenuItem>;
    var activeBasket = ViewBag.CurrentBasket as ChapeauProject.Models.Order;
    var currentCard = (MenuCard)ViewBag.CardFilter;
}

<div class="page-header">
    <h2>Table @Model.TableNumber Workspace</h2>
    <a asp-action="Details" asp-route-id="@Model.TableNumber" class="complete-btn btn-inline">&#8635; Refresh</a>
</div>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h3 class="mb-3 mt-2 menu-heading">Active Table Consumption Log</h3>

@if (!Model.Guests.Any())
{
    <p class="text-muted fst-italic py-2">No guests found on this table.</p>
}
else
{
    @foreach (var guest in Model.Guests)
    {
        <h4>@guest.FullName</h4>
        <table class="table table-sm align-middle mb-4">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!guest.Items.Any())
                {
                    <tr><td colspan="4" class="text-muted fst-italic">No orders yet</td></tr>
                }
                else
                {
                    @foreach (var item in guest.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ItemName</td>
                            <td>@item.Quantity</td>
                            <td>€@item.Price.ToString("F2")</td>
                            <td>
                                <form asp-action="ToggleItem" asp-controller="Orders" method="post" class="form-inline">
                                    <input type="hidden" name="orderItemId" value="@item.OrderItemID" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Tables", new { id = Model.TableNumber })" />
                                    <button type="submit" class="@item.StatusPillClass">@item.StatusLabel</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

<div class="bg-light p-3 rounded mb-4 border shadow-sm vat-summary">
    <p class="mb-1 small text-secondary">Low VAT (9%): <span class="fw-bold text-dark float-end">€@Model.LowVAT.ToString("F2")</span></p>
    <p class="mb-2 small text-secondary">High VAT (21%): <span class="fw-bold text-dark float-end">€@Model.HighVAT.ToString("F2")</span></p>
    <h5 class="m-0 pt-2 border-top fw-bold menu-item-name">Total (incl. VAT): <span class="float-end">€@Model.TotalAmount.ToString("F2")</span></h5>
</div>

<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary py-2 px-3">Back to Tables Grid</a>
    <a asp-action="Pay" asp-controller="Bill" asp-route-id="@Model.TableNumber"
       class="complete-btn btn-inline" style="padding:10px 24px; margin-left:8px;">
        Process Bill Checkout
    </a>
</div>

<hr class="details-divider my-5" />

<div class="row pt-2">

    <div class="col-md-7 pe-4">
        <h3 class="mb-4 menu-heading">Add Items to Order</h3>

        <div class="d-flex mb-3">
            <div class="btn-group">
                <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="Lunch" class="btn btn-outline-dark @(currentCard == MenuCard.Lunch ? "active" : "")">Lunch</a>
                <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="Dinner" class="btn btn-outline-dark @(currentCard == MenuCard.Dinner ? "active" : "")">Dinner</a>
                <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="Drinks" class="btn btn-outline-dark @(currentCard == MenuCard.Drinks ? "active" : "")">Drinks</a>
            </div>
        </div>

        @if (currentCard != MenuCard.Drinks)
        {
            <div class="d-flex mb-4">
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="@currentCard" asp-route-courseFilter="@CourseFilter.All" class="btn btn-light @(ViewBag.CourseFilter == CourseFilter.All ? "active" : "")">All</a>
                    <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="@currentCard" asp-route-courseFilter="Starter" class="btn btn-light @(ViewBag.CourseFilter == "Starter" ? "active" : "")">Starters</a>
                    <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="@currentCard" asp-route-courseFilter="Main" class="btn btn-light @(ViewBag.CourseFilter == "Main" ? "active" : "")">Mains</a>
                    <a asp-action="Details" asp-route-id="@Model.TableNumber" asp-route-cardFilter="@currentCard" asp-route-courseFilter="Dessert" class="btn btn-light @(ViewBag.CourseFilter == "Dessert" ? "active" : "")">Desserts</a>
                </div>
            </div>
        }

        <div class="table-responsive bg-white rounded shadow-sm border">
            <table class="table table-hover align-middle mb-0">
                <thead class="menu-thead">
                    <tr>
                        <th class="py-3 ps-3">Item Name</th>
                        <th class="py-3">Price</th>
                        <th class="py-3 text-center pe-3" style="width:80px;">Add</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in menuItems)
                    {
                        <tr>
                            <td class="fw-bold py-3 ps-3 menu-item-name">@item.ItemName</td>
                            <td class="text-secondary">@item.PriceDisplay</td>
                            <td class="text-center pe-3">
                                <form asp-controller="Orders" asp-action="AddItemToOrder" method="post" class="m-0">
                                    <input type="hidden" name="menuItemID" value="@item.MenuItemID" />
                                    <button type="submit" class="add-item-btn" @(!item.IsAvailable ? "disabled" : "")>+</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-5">
        <div id="basket" class="card shadow-sm border-0 position-sticky basket-card details-basket mb-4">
            <div class="card-body p-4">

                <div class="text-center pb-2 mb-4 border-bottom">
                    <h4 class="fw-bold m-0 basket-heading">New Order Ticket</h4>
                    <small class="text-muted fw-semibold">Table @Model.TableNumber Processing Drawer</small>
                </div>

                <div class="basket-items-list overflow-auto pe-1">
                    @if (activeBasket == null || !activeBasket.OrderItems.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <p class="m-0 fs-5">Basket is empty.</p>
                            <small>Tap the circular "+" button next to any dish item on the left panel to build out this order.</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var basketItem in activeBasket.OrderItems)
                        {
                            <div class="p-3 mb-3 border rounded bg-white shadow-sm basket-item">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="fw-bold text-dark small pe-2">@basketItem.MenuItem?.ItemName</span>
                                    <form asp-controller="Orders" asp-action="RemoveRow" method="post" class="m-0">
                                        <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                        <button type="submit" class="btn btn-sm p-0 border-0 text-muted hover-danger" title="Remove row item completely">🗑️</button>
                                    </form>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <div class="d-flex align-items-center bg-light rounded border px-1">
                                        <form asp-controller="Orders" asp-action="DecreaseQuantity" method="post" class="m-0">
                                            <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                            <button type="submit" class="btn btn-sm border-0 px-2 py-0 fw-bold text-secondary">-</button>
                                        </form>
                                        <span class="px-2 small fw-bold text-dark basket-item-qty">@basketItem.Quantity</span>
                                        <form asp-controller="Orders" asp-action="IncreaseQuantity" method="post" class="m-0">
                                            <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                            <button type="submit" class="btn btn-sm border-0 px-2 py-0 fw-bold text-secondary">+</button>
                                        </form>
                                    </div>
                                    <span class="text-secondary small fw-bold">
                                        €@((basketItem.MenuItem != null ? basketItem.MenuItem.Price * basketItem.Quantity : 0).ToString("0.00"))
                                    </span>
                                </div>

                                <div class="mt-3">
                                    <form asp-controller="Orders" asp-action="UpdateItemComment" method="post" class="m-0 input-group input-group-sm">
                                        <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                        <span class="input-group-text bg-light text-muted border-end-0">📝</span>
                                        <input type="text" name="comment" value="@basketItem.Comment"
                                               placeholder="Add instructions ('no salt', 'rare')..."
                                               class="form-control bg-light border-start-0 ps-1 comment-input"
                                               onchange="this.form.submit();" />
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (activeBasket != null && activeBasket.OrderItems.Any())
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-grid gap-2">
                            <form asp-controller="Orders" asp-action="SaveAndSendOrder" method="post" class="m-0 w-100">
                                <input type="hidden" name="guest.FirstName" id="guestFirstNameInput" value="" />
                                <input type="hidden" name="guest.LastName" id="guestLastNameInput" value="" />
                                <select name="guest.GuestID" class="form-select mb-2 guest-select" required
                                        onchange="
                                            var opt = this.options[this.selectedIndex];
                                            document.getElementById('guestFirstNameInput').value = opt.dataset.firstname;
                                            document.getElementById('guestLastNameInput').value = opt.dataset.lastname;">
                                    <option value="0" disabled selected>— Select guest —</option>
                                    @foreach (var guest in (List<ChapeauProject.Models.Guest>)ViewBag.Guests)
                                    {
                                        <option value="@guest.GuestID" data-firstname="@guest.FirstName" data-lastname="@guest.LastName">@guest.FullName</option>
                                    }
                                </select>
                                <button type="submit" class="send-order-btn">🚀 Send to Kitchen / Bar</button>
                            </form>
                            <form asp-controller="Orders" asp-action="CancelWholeOrder" method="post" class="m-0 w-100">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-1 cancel-order-btn"
                                        onclick="return confirm('Wipe out and reset this local workspace basket entirely?');">
                                    Cancel Selection
                                </button>
                            </form>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

</div>
