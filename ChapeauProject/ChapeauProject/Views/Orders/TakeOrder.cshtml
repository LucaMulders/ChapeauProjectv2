@using ChapeauProject.Models
@using ChapeauProject.ViewModels
@model List<MenuItem>

@{
    ViewData["Title"] = "Take Order";
    var activeBasket = ViewBag.CurrentBasket as ChapeauProject.Models.Order;
}

<div class="container-fluid mt-4 px-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Stock Alert:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-7 pe-4">
            <h2 class="mb-4 menu-heading">Menu Selection</h2>

            <div class="d-flex mb-3">
                <div class="btn-group">
                    <a asp-action="TakeOrder" asp-route-cardFilter="Lunch" class="btn btn-outline-dark @((MenuCard)ViewBag.CardFilter == MenuCard.Lunch ? "active" : "")">Lunch</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="Dinner" class="btn btn-outline-dark @((MenuCard)ViewBag.CardFilter == MenuCard.Dinner ? "active" : "")">Dinner</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="Drinks" class="btn btn-outline-dark @((MenuCard)ViewBag.CardFilter == MenuCard.Drinks ? "active" : "")">Drinks</a>
                </div>
            </div>

            <div class="d-flex mb-4">
                <div class="btn-group btn-group-sm">
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="@CourseFilter.All" class="btn btn-light @(ViewBag.CourseFilter == CourseFilter.All ? "active" : "")">All</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="Starter" class="btn btn-light @(ViewBag.CourseFilter == "Starter" ? "active" : "")">Starters</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="Main" class="btn btn-light @(ViewBag.CourseFilter == "Main" ? "active" : "")">Mains</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="Dessert" class="btn btn-light @(ViewBag.CourseFilter == "Dessert" ? "active" : "")">Desserts</a>
                </div>
            </div>

            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover align-middle mb-0">
                    <thead class="menu-thead">
                        <tr>
                            <th class="py-3 ps-3">Item Name</th>
                            <th class="py-3">Price</th>
                            <th class="py-3">Stock Status</th>
                            <th class="py-3 text-center pe-3" style="width:80px;">Add</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold py-3 ps-3 menu-item-name">@item.ItemName</td>
                                <td class="text-secondary">@item.PriceDisplay</td>
                                <td>
                                    @if (!item.IsAvailable)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (item.StockQuantity <= 10)
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock (@item.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In Stock</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <form asp-action="AddItemToOrder" method="post" class="m-0">
                                        <input type="hidden" name="menuItemID" value="@item.MenuItemID" />
                                        <button type="submit" class="add-item-btn" @(!item.IsAvailable ? "disabled" : "")>+</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0 position-sticky basket-card mb-4">
                <div class="card-body p-4">

                    <div class="text-center pb-3 mb-4 border-bottom">
                        <h3 class="fw-bold m-0 basket-heading">Table @(activeBasket?.Table.TableNumber ?? 0)</h3>
                        <small class="text-muted fw-semibold">Active Workspace Overview</small>
                    </div>

                    <div class="basket-items-list overflow-auto pe-1">
                        @if (activeBasket == null || !activeBasket.OrderItems.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <p class="m-0 fs-5">No items selected yet.</p>
                                <small>Tap the "+" button next to a menu item to begin taking an order.</small>
                            </div>
                        }
                        else
                        {
                            @foreach (var basketItem in activeBasket.OrderItems)
                            {
                                <div class="p-3 mb-3 border rounded bg-white shadow-sm basket-item">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="fw-bold text-dark pe-2 basket-item-name">@basketItem.MenuItem?.ItemName</span>
                                        <form asp-action="RemoveRow" method="post" class="m-0">
                                            <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                            <button type="submit" class="btn btn-sm p-0 border-0 text-muted hover-danger" title="Remove Item">🗑️</button>
                                        </form>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div class="d-flex align-items-center bg-light rounded border px-1">
                                            <form asp-action="DecreaseQuantity" method="post" class="m-0">
                                                <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                                <button type="submit" class="btn btn-sm fw-bold px-2 py-1 border-0 text-secondary">-</button>
                                            </form>
                                            <span class="px-3 fw-bold text-dark basket-item-qty">@basketItem.Quantity</span>
                                            <form asp-action="IncreaseQuantity" method="post" class="m-0">
                                                <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                                <button type="submit" class="btn btn-sm fw-bold px-2 py-1 border-0 text-secondary">+</button>
                                            </form>
                                        </div>
                                        <span class="text-secondary fw-semibold small">
                                            €@((basketItem.MenuItem != null ? basketItem.MenuItem.Price * basketItem.Quantity : 0).ToString("0.00"))
                                        </span>
                                    </div>

                                    <div class="mt-3">
                                        <form asp-action="UpdateItemComment" method="post" class="m-0 input-group input-group-sm">
                                            <input type="hidden" name="menuItemID" value="@basketItem.MenuItem?.MenuItemID" />
                                            <span class="input-group-text bg-light text-muted border-end-0">📝</span>
                                            <input type="text" name="comment" value="@basketItem.Comment"
                                                   placeholder="Add special notes ('no salt', 'rare')..."
                                                   class="form-control border-start-0 ps-1 bg-light comment-input"
                                                   onchange="this.form.submit();" />
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (activeBasket != null && activeBasket.OrderItems.Any())
                    {
                        <div class="mt-4 pt-3 border-top">
                            <div class="d-grid gap-2">
                                <form asp-action="SaveAndSendOrder" method="post" class="m-0 w-100">
                                    <button type="submit" class="send-order-btn">🚀 Send to Kitchen / Bar</button>
                                </form>
                                <form asp-action="CancelWholeOrder" method="post" class="m-0 w-100">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-2 cancel-order-btn"
                                            onclick="return confirm('Are you sure you want to cancel and wipe out this entire working order?');">
                                        Cancel Order
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
<