@using ChapeauProject.Models
@model List<ChapeauProject.Models.MenuItem>

@{
    ViewData["Title"] = "Take Order";
    var activeBasket = ViewBag.CurrentBasket as ChapeauProject.Models.Order;
}

<div class="container-fluid mt-4 px-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Stock Alert:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-7 pe-4">
            <h2 class="mb-4" style="font-family: 'Playfair Display'; color: #3d2514;">Menu Selection</h2>

            <div class="d-flex mb-3">
                <div class="btn-group">
                    <a asp-action="TakeOrder" asp-route-cardFilter="Lunch" class="btn btn-outline-dark @((MenuCard)ViewBag.CardFilter == MenuCard.Lunch ? "active" : "")">Lunch</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="Dinner" class="btn btn-outline-dark @((MenuCard)ViewBag.CardFilter == MenuCard.Dinner ? "active" : "")">Dinner</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="Drinks" class="btn btn-outline-dark @((MenuCard)ViewBag.CardFilter == MenuCard.Drinks ? "active" : "")">Drinks</a>
                </div>
            </div>

            <div class="d-flex mb-4">
                <div class="btn-group btn-group-sm">
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="All" class="btn btn-light @(ViewBag.CourseFilter == "All" ? "active" : "")">All</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="Starter" class="btn btn-light @(ViewBag.CourseFilter == "Starter" ? "active" : "")">Starters</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="Main" class="btn btn-light @(ViewBag.CourseFilter == "Main" ? "active" : "")">Mains</a>
                    <a asp-action="TakeOrder" asp-route-cardFilter="@ViewBag.CardFilter" asp-route-courseFilter="Dessert" class="btn btn-light @(ViewBag.CourseFilter == "Dessert" ? "active" : "")">Desserts</a>
                </div>
            </div>

            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #2b1810; color: #fdfaf6;">
                        <tr>
                            <th class="py-3 ps-3">Item Name</th>
                            <th class="py-3">Price</th>
                            <th class="py-3">Stock Status</th>
                            <th class="py-3 text-center pe-3" style="width: 80px;">Add</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold py-3 ps-3" style="color: #2b1810;">@item.ItemName</td>
                                <td class="text-secondary">€@item.Price.ToString("0.00")</td>
                                <td>
                                    @if (item.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (item.StockQuantity <= 10)
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock (@item.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In Stock</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <form asp-action="AddItemToOrder" method="post" class="m-0">
                                        <input type="hidden" name="menuItemID" value="@item.MenuItemID" />
                                        <button type="submit" class="btn btn-sm text-white fw-bold d-flex align-items-center justify-content-center mx-auto"
                                                style="background-color: #cda45e; border-radius: 50%; width: 32px; height: 32px; border: none;"
                                                @(item.StockQuantity == 0 ? "disabled" : "")>
                                            +
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0 position-sticky mb-4" style="top: 20px; border-radius: 16px; background-color: #fdfaf6;">
                <div class="card-body p-4">

                    <div class="text-center pb-3 mb-4 border-bottom">
                        <h3 class="fw-bold m-0" style="font-family: 'Playfair Display'; color: #2b1810;">
                            Table @(activeBasket?.TableNumber ?? 0)
                        </h3>
                        <small class="text-muted fw-semibold">Active Workspace Overview</small>
                    </div>

                    <div class="basket-items-list overflow-auto pe-1" style="max-height: 400px;">
                        @if (activeBasket == null || !activeBasket.OrderItems.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <p class="m-0 fs-5">No items selected yet.</p>
                                <small>Tap the "+" button next to a menu item to begin taking an order.</small>
                            </div>
                        }
                        else
                        {
                            @foreach (var basketItem in activeBasket.OrderItems)
                            {
                                <div class="p-3 mb-3 border rounded bg-white shadow-sm" style="border-left: 5px solid #cda45e !important;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="fw-bold text-dark pe-2" style="font-size: 0.95rem;">
                                            @basketItem.MenuItem?.ItemName
                                        </span>

                                        <form asp-action="RemoveRow" method="post" class="m-0">
                                            <input type="hidden" name="menuItemID" value="@basketItem.MenuItemID" />
                                            <button type="submit" class="btn btn-sm p-0 border-0 text-muted hover-danger" title="Remove Item">🗑️</button>
                                        </form>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">

                                        <div class="d-flex align-items-center bg-light rounded border px-1">
                                            <form asp-action="DecreaseQuantity" method="post" class="m-0">
                                                <input type="hidden" name="menuItemID" value="@basketItem.MenuItemID" />
                                                <button type="submit" class="btn btn-sm fw-bold px-2 py-1 border-0 text-secondary" style="box-shadow: none;">-</button>
                                            </form>

                                            <span class="px-3 fw-bold text-dark" style="font-size: 0.9rem; min-width: 35px; text-align: center;">
                                                @basketItem.Quantity
                                            </span>

                                            <form asp-action="IncreaseQuantity" method="post" class="m-0">
                                                <input type="hidden" name="menuItemID" value="@basketItem.MenuItemID" />
                                                <button type="submit" class="btn btn-sm fw-bold px-2 py-1 border-0 text-secondary" style="box-shadow: none;">+</button>
                                            </form>
                                        </div>

                                        <span class="text-secondary fw-semibold small">
                                            €@((basketItem.MenuItem != null ? basketItem.MenuItem.Price * basketItem.Quantity : 0).ToString("0.00"))
                                        </span>
                                    </div>

                                    <div class="mt-3">
                                        <form asp-action="UpdateItemComment" method="post" class="m-0 input-group input-group-sm">
                                            <input type="hidden" name="menuItemID" value="@basketItem.MenuItemID" />
                                            <span class="input-group-text bg-light text-muted border-end-0">📝</span>
                                            <input type="text" name="comment" value="@basketItem.Comment"
                                                   placeholder="Add special notes ('no salt', 'rare')..."
                                                   class="form-control border-start-0 ps-1 bg-light"
                                                   style="font-size: 0.82rem;"
                                                   onchange="this.form.submit();" />
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (activeBasket != null && activeBasket.OrderItems.Any())
                    {
                        <div class="mt-4 pt-3 border-top">
                            <div class="d-grid gap-2">
                                <form asp-action="SaveAndSendOrder" method="post" class="m-0 w-100">
                                    <button type="submit" class="btn text-white w-100 py-2.5 fw-bold shadow-sm" style="background-color: #2b1810; border-radius: 8px;">
                                        🚀 Send to Kitchen / Bar
                                    </button>
                                </form>

                                <form asp-action="CancelWholeOrder" method="post" class="m-0 w-100">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-2"
                                            onclick="return confirm('Are you sure you want to cancel and wipe out this entire working order?');"
                                            style="border-radius: 8px;">
                                        Cancel Order
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</div>

<style>
   
    .hover-danger:hover {
        color: #dc3545 !important;
        transition: color 0.2s;
    }

    .btn-outline-dark.active {
        background-color: #2b1810 !important;
        border-color: #2b1810 !important;
        color: #fdfaf6 !important;
    }

    .btn-outline-dark {
        color: #2b1810;
        border-color: #2b1810;
    }

        .btn-outline-dark:hover {
            background-color: #cda45e;
            border-color: #cda45e;
            color: white;
        }

    .btn-light.active {
        background-color: #cda45e !important;
        color: white !important;
        border-color: #cda45e !important;
    }

    .basket-items-list::-webkit-scrollbar {
        width: 5px;
    }

    .basket-items-list::-webkit-scrollbar-thumb {
        background: #cda45e;
        border-radius: 4px;
    }
</style>