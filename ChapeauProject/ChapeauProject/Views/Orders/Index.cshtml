@model IEnumerable<ChapeauProject.ViewModels.TableOrderGroupViewModel>

@{
    ViewData["Title"] = "Running Orders";
    string filter = ViewBag.Filter as string ?? "running";
}

<div class="page-header">
    <h2 class="page-title">@ViewBag.PageTitle</h2>
    <div class="filter-tabs">
        <a asp-action="Index" asp-route-filter="running"
           class="filter-tab @(filter == "running" ? "filter-tab-active" : "")">Running</a>
        <a asp-action="Index" asp-route-filter="finished"
           class="filter-tab @(filter == "finished" ? "filter-tab-active" : "")">Finished Today</a>
    </div>
</div>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-banner">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">@ViewBag.EmptyMessage</p>
}
else
{
    <div class="orders-grid">
        @foreach (var tableGroup in Model)
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div class="order-table-num">Table @tableGroup.TableNumber</div>
                </div>

                @for (int i = 0; i < tableGroup.Orders.Count; i++)
                {
                    @await Html.PartialAsync("_OrderGroup", tableGroup.Orders[i])
                    @if (i < tableGroup.Orders.Count - 1)
                    {
                        <hr class="order-divider" />
                    }
                }
            </div>
        }
    </div>
}

<div class="refresh-bar">
    <a asp-action="Index" class="complete-btn btn-inline">&#8635; Refresh</a>
</div>
