@model IEnumerable<ChapeauProject.ViewModels.RunningOrderViewModel>

@{
    ViewData["Title"] = "Running Orders";
}

@{
    string activeFilter = ViewBag.Filter as string ?? "running";
}

<div class="page-header">
    <h2 class="page-title">
        @(activeFilter == "finished" ? "Finished Orders Today" : "Running Orders")
    </h2>
    <div class="filter-tabs">
        <a asp-action="Index" asp-route-filter="running"
           class="filter-tab @(activeFilter == "running" ? "filter-tab-active" : "")">Running</a>
        <a asp-action="Index" asp-route-filter="finished"
           class="filter-tab @(activeFilter == "finished" ? "filter-tab-active" : "")">Finished Today</a>
    </div>
</div>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-banner">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">
        @(activeFilter == "finished" ? "No finished orders today yet." : "No running orders at the moment.")
    </p>
}
else
{
    <div class="orders-grid">
        @foreach (var tableGroup in Model.GroupBy(o => o.TableNumber).OrderBy(g => g.Key))
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div class="order-table-num">Table @tableGroup.Key</div>
                </div>

                @foreach (var order in tableGroup)
                {
                    @await Html.PartialAsync("_OrderGroup", order)
                    @if (order != tableGroup.Last())
                    {
                        <hr class="order-divider" />
                    }
                }
            </div>
        }
    </div>
}

<div class="refresh-bar">
    <a asp-action="Index" class="complete-btn btn-inline">&#8635; Refresh</a>
</div>
