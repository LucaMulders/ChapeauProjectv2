@model IEnumerable<ChapeauProject.ViewModels.RunningOrderViewModel>
@using ChapeauProject.Models

@{
    ViewData["Title"] = "Running Orders";
}

<h2 style="font-family:'Playfair Display',serif; color:var(--bistro-text);">Running Orders</h2>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:#A32D2D; color:white; padding:10px 16px; border-radius:6px; margin-bottom:1rem;">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <p style="color:#999;">No running orders at the moment.</p>
}
else
{
    <div class="orders-grid">
        @foreach (var tableGroup in Model.GroupBy(o => o.TableNumber).OrderBy(g => g.Key))
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div class="order-table-num">Table @tableGroup.Key</div>
                </div>

                @foreach (var order in tableGroup)
                {
                    <div style="margin-bottom:0.5rem;">
                        <div class="order-meta" style="margin-bottom:4px;">
                            Order #@order.OrderID &bull; @order.OrderTime.ToString("HH:mm") &bull; Wait: @order.WaitingTime.Hours h @order.WaitingTime.Minutes m
                        </div>

                        @foreach (var item in order.Items)
                        {
                            <div class="order-item-row">
                                <form asp-action="ToggleItem" asp-controller="Orders" method="post" style="display:contents;">
                                    <input type="hidden" name="orderItemId" value="@item.OrderItemID" />
                                    <span class="order-item-name @(item.PreparationStatus == PreparationStatus.Ready ? "done" : "")">@item.ItemName</span>
                                    <span class="order-item-qty">x@(item.Quantity)</span>
                                    @{
                                        var (pillClass, label) = item.PreparationStatus switch
                                        {
                                            PreparationStatus.Pending   => ("status-pill status-ordered",   "Ordered"),
                                            PreparationStatus.Preparing => ("status-pill status-preparing", "Being Prepared"),
                                            PreparationStatus.Ready      => ("status-pill status-ready",     "Ready to Serve"),
                                            _                           => ("status-pill", item.PreparationStatus.ToString())
                                        };
                                    }
                                    <button type="submit" class="@pillClass">@label</button>
                                </form>
                            </div>
                        }

                        @{
                            bool allReady = order.Items.All(i => i.PreparationStatus == PreparationStatus.Ready);
                        }
                        <form asp-action="CompleteOrder" asp-controller="Orders" method="post" style="margin-top:6px;">
                            <input type="hidden" name="orderId" value="@order.OrderID" />
                            <button type="submit" class="complete-btn" @(allReady ? "" : "disabled title=\"All items must be Ready first\"")
                                style="@(allReady ? "" : "opacity:0.4; cursor:not-allowed;")">
                                Mark as Served
                            </button>
                        </form>
                    </div>

                    @if (order != tableGroup.Last())
                    {
                        <hr style="border-color:#e0d6c8; margin:0.75rem 0;" />
                    }
                }
            </div>
        }
    </div>
}

<div style="margin-top:1.5rem;">
    <a asp-action="Index" class="complete-btn" style="display:inline-block; width:auto; padding: 7px 20px; text-decoration:none;">&#8635; Refresh</a>
</div>

<style>
    .status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: opacity 0.15s;
        white-space: nowrap;
    }
    .status-pill:hover { opacity: 0.8; }
    .status-ordered   { background: #FFF3CD; color: #856404; }
    .status-preparing { background: #CCE5FF; color: #004085; }
    .status-ready     { background: #D4EDDA; color: #155724; }
</style>
