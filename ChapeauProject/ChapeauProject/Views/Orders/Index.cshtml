@model ChapeauProject.ViewModels.OrdersIndexViewModel

@{
    ViewData["Title"] = "Running Orders";
}

<div class="page-header">
    <h2 class="page-title">@Model.PageTitle</h2>
    <div class="filter-tabs">
        <a asp-action="Index" asp-route-filter="running"
           class="filter-tab @(Model.Filter == "running" ? "filter-tab-active" : "")">Running</a>
        <a asp-action="Index" asp-route-filter="finished"
           class="filter-tab @(Model.Filter == "finished" ? "filter-tab-active" : "")">Finished Today</a>
    </div>
</div>
<hr />

<partial name="_ErrorMessage" />

@if (!Model.TableGroups.Any())
{
    <p class="text-muted">@Model.EmptyMessage</p>
}
else
{
    <div class="orders-grid">
        @foreach (var tableGroup in Model.TableGroups)
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div class="order-table-num">Table @tableGroup.TableNumber</div>
                </div>

                @for (int i = 0; i < tableGroup.Orders.Count; i++)
                {
                    @await Html.PartialAsync("_OrderGroup", tableGroup.Orders[i],
                        new ViewDataDictionary(ViewData) { { "StaffRole", Model.StaffRole } })
                    @if (i < tableGroup.Orders.Count - 1)
                    {
                        <hr class="order-divider" />
                    }
                }
            </div>
        }
    </div>
}

<div class="refresh-bar">
    <a asp-action="Index" class="complete-btn btn-inline">&#8635; Refresh</a>
</div>
