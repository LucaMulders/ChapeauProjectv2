# ---------------------------------------------
# .gitignore for .NET / Visual Studio projects
# ---------------------------------------------

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio cache/options directory
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET build / restore output
project.lock.json
project.fragment.lock.json
artifacts/
*.dll
*.exe
*.pdb

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Misc caches
*.cache
*.v2
*.Up2Date
